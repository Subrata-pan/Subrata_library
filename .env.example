# Email Configuration for Flask-Mail
# Use Gmail SMTP settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# Your Gmail credentials
# IMPORTANT: Use App Password, not your regular Gmail password
# How to get App Password: https://support.google.com/accounts/answer/185833
MAIL_USERNAME=simapan1996@gmail.com
MAIL_PASSWORD=your_16_character_app_password_here

# Default sender email (can be the same as MAIL_USERNAME)
MAIL_DEFAULT_SENDER=simapan1996@gmail.com

# Database Configuration (optional)
DATABASE_URL=sqlite:///kitabghar.db

# Session Secret (optional)
SESSION_SECRET=your_secret_key_here
WTF_CSRF_SSL_STRICT=False

# Admin account created/updated automatically on deploy
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=use_a_strong_password_here

# Google Sign-In Configuration (optional)
# Create an OAuth 2.0 Client ID in Google Cloud Console.
# Authorized redirect URI for local development:
# http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Books API key is optional. Search works without it for normal use.
GOOGLE_BOOKS_API_KEY=
